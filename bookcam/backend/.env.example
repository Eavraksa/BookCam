# Copy this file to ".env" and fill in the values. NEVER commit ".env".

PORT=5000

# Comma-separated list of allowed browser origins (your React app URL)
CORS_ORIGIN=http://localhost:5173

# Firebase Admin SDK credentials.
# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# Copy the three values from the downloaded JSON file.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the quotes and the literal \n sequences exactly as they appear in the JSON file.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_YOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Default Storage bucket shown in Firebase Console -> Storage
# (either your-project-id.firebasestorage.app or your-project-id.appspot.com)
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
