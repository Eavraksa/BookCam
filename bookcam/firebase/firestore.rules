rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    // "role" is a custom claim that only the backend (Admin SDK) can set.
    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---------- users ----------
    // Customers can create/read/update only their own profile and can never
    // grant themselves a role. Role changes go through the Express API.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'customer'
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt']);

      allow update: if isOwner(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email;

      allow delete: if false; // backend only
    }

    // ---------- books & categories ----------
    // Anyone can browse the catalogue. All writes go through the Express API
    // (which verifies the admin role and validates the data).
    match /books/{bookId} {
      allow read: if true;
      allow write: if false;
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- carts ----------
    // One document per user: carts/{uid} = { items: [{bookId, quantity}], updatedAt }
    match /carts/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 50;
      allow delete: if isOwner(uid);
    }

    // ---------- orders ----------
    // Created and changed only by the backend (price + stock are computed server-side).
    match /orders/{orderId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
